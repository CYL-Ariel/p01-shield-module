#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NUM 1 // Number layer
#define NAV 2 // Navigation layer
#define BLU 3 // Bluetooth config layer

/ {
    keymap {
        compatible = "zmk,keymap";

// from p01.dsti
//         | SW1   | SW2   | SW3   | SW4   | SW5   | SW6   |                               | SW6   | SW5    | SW4    | SW3    | SW2    | SW1    |
// | SW7   | SW8   | SW9   | SW10  | SW11  | SW12  |                                               | SW12   | SW11   | SW10   | SW9    | SW8    | SW7    |
// | SW13  | SW14  | SW15  | SW16  | SW17  | SW18  | SW19  |                               | SW19  | SW18   | SW17   | SW16   | SW15   | SW14   | SW13   |
//                         | SW20  | SW21  | SW22  | SW23  | SW24  | SW25 || SW25  | SW24  | SW23  | SW22   | SW21   | SW20   | 
//          RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)                                 RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
//  RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                                 RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
//  RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(1,6)                                 RC(1,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)
//                          RC(3,3) RC(3,4) RC(3,5) RC(2,6) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(2,9) RC(3,10) RC(3,11) RC(3,12)
        default_layer { // Layer 0
            bindings = <
                &kp Q   &kp W   &kp E    &kp R   &kp T     &kp MINUS                                   &kp EQUAL         &kp Y     &kp U   &kp I     &kp O    &kp P    
&mt &to NUM TAB &kp A   &kp S   &kp D    &kp F   &kp G                                                                   &kp H     &kp J   &kp K     &kp L    &kp SEMI &kp ENTER
&kp LSHFT       &kp Z   &kp X   &kp C    &kp V   &kp B     &kp LBKT                                    &kp RBKT          &kp N     &kp M   &kp COMMA &kp DOT  &kp FLSH &MT RSHFT ENTER                  
                                &kp BSPC &to NAV &kp SPACE &mt LALT $tog NUM &kp LCTRL &mt RCTRL $CAPS &mt RALT $tog NUM $kp SPACE $to NAV $kp BSPC
                        RC(3,3) RC(3,4) RC(3,5) RC(2,6) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(2,9) RC(3,10) RC(3,11) RC(3,12)
            >;
        };
        num_layer { // Layer 1
            bindings = <
                &kp EXCL &kp AT &kp HASH &kp DLLR &kp PCNT  &kp ESC                                     &kp ESC           &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR    
&mt &to NUM TAB &kp N1  &kp N2  &kp N3   &kp N4   &kp N5                                                                  &kp N6    &kp N7   &kp N8   &kp N9   &kp SEMI &kp SQT
&kp LSHFT       &none   &none   &none    &none    &none     &to BLU                                     &to BLU           &none     &none    &none    &none    &none              
                                &kp BSPC &to NAV  &kp SPACE &mt LALT $tog NUM &kp LCTRL &mt RCTRL $CAPS &mt RALT $tog NUM $kp SPACE $to NAV  $kp BSPC
            >;
        };
        num_layer { // Layer 2
            bindings = <
      &none &none &UP      &none   &none     &none    &none    &none &none &none &none &none    
&none &none &LEFT &DOWN    &RIGHT  &none     &none    &none    &none     &none &none &none
&none &none &none &none    &none   &none     &none    &none    &none     &none &none &none &none &none           
                  &kp BSPC &to NAV &kp SPACE &mt LALT $tog NUM &kp LCTRL &mt RCTRL $CAPS &mt RALT $tog NUM $kp SPACE $to NAV  $kp BSPC
            >;
        };
        blu_layer { // Layer 3
    &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &none &to BASE &to BASE &none &bt BT_CLR &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0 &none
&none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none &none 
&none &none &none &none &none &none &none &none &none &none &none &none 
        }
    };
 };